{
  "name": "patudos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "npm run dev -w @patudos/landing",
    "dev:api": "npm run dev -w @patudos/api",
    "build:landing": "npm run build -w @patudos/landing",
    "build:api": "npm run build -w @patudos/api",
    "db:push": "npm run push -w @patudos/db",
    "db:generate": "npm run generate -w @patudos/db",
    "db:studio": "npm run studio -w @patudos/db"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
